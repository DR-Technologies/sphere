# Sphere Environment Variables Template
# Copy this to .env.local for local development
# Configure these in Vercel Dashboard for production

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Analytics Provider
NEXT_PUBLIC_ANALYTICS_PROVIDER=supabase

# Maps
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Account billing (Stripe Test Mode only for V1 validation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_your_test_secret
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
STRIPE_PRICE_PRO=price_your_test_pro_price
STRIPE_PRICE_ENTERPRISE=price_your_test_enterprise_price
